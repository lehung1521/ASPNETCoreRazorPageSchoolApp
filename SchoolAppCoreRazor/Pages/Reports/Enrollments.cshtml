@page
@model SchoolAppCoreRazor.Pages.Reports.EnrollmentsModel
@{
    ViewData["Title"] = "Enrollment Report";
}

<h1>Enrollment Report (.rdlc)</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">Department</label>
        <select name="departmentId" class="form-select" asp-items="Model.Departments">
            <option value="">-- All departments --</option>
        </select>
    </div>
    <input type="hidden" name="show" value="true" />
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">View report</button>
    </div>
    <div class="col-auto">
        <a class="btn btn-success" asp-page="/Reports/Enrollments" asp-page-handler="Excel" asp-route-departmentId="@Model.DepartmentId">Export Excel</a>
        <a class="btn btn-secondary" asp-page="/Reports/Enrollments" asp-page-handler="Word" asp-route-departmentId="@Model.DepartmentId">Export Word</a>
    </div>
</form>

@if (Model.Show)
{
    <iframe src="@Url.Page("/Reports/Enrollments", "Pdf", new { departmentId = Model.DepartmentId })"
            style="width:100%; height:650px; border:1px solid #ccc"></iframe>
}
