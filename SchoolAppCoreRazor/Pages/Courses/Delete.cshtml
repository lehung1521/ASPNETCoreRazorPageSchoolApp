@page "{id:int?}"
@model SchoolAppCoreRazor.Pages.Courses.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<div>
    <h4>Course</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Item.CourseID</dd>
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Item.Title</dd>
        <dt class="col-sm-3">Credits</dt>
        <dd class="col-sm-9">@Model.Item.Credits</dd>
        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Item.Department?.Name</dd>
    </dl>

    <form method="post">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
