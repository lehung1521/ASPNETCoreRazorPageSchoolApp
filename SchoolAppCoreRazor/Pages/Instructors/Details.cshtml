@page "{id:int?}"
@model SchoolAppCoreRazor.Pages.Instructors.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<h4>Instructor</h4>
<hr />
<dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Item.InstructorID</dd>
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.Item.FirstName</dd>
        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.Item.LastName</dd>
        <dt class="col-sm-3">Hire Date</dt>
        <dd class="col-sm-9">@Model.Item.HireDate.ToString("yyyy-MM-dd")</dd>
</dl>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Item.InstructorID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
