@page "{id:int?}"
@model SchoolAppCoreRazor.Pages.Instructors.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<div>
    <h4>Instructor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Item.InstructorID</dd>
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.Item.FirstName</dd>
        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.Item.LastName</dd>
        <dt class="col-sm-3">Hire Date</dt>
        <dd class="col-sm-9">@Model.Item.HireDate.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form method="post">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
