@page
@model SchoolAppCoreRazor.Pages.Instructors.IndexModel
@{
    ViewData["Title"] = "Instructors";
}

<h1>Instructors</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Hire Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Items)
{
        <tr>
            <td>@item.InstructorID</td>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.HireDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.InstructorID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.InstructorID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.InstructorID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
