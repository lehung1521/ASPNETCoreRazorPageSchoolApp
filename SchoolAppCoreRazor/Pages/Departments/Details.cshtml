@page "{id:int?}"
@model SchoolAppCoreRazor.Pages.Departments.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<h4>Department</h4>
<hr />
<dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Item.DepartmentID</dd>
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Item.Name</dd>
        <dt class="col-sm-3">Budget</dt>
        <dd class="col-sm-9">@Model.Item.Budget.ToString("N2")</dd>
        <dt class="col-sm-3">Start Date</dt>
        <dd class="col-sm-9">@Model.Item.StartDate.ToString("yyyy-MM-dd")</dd>
</dl>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Item.DepartmentID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
