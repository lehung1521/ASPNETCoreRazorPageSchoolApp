@page "{id:int?}"
@model SchoolAppCoreRazor.Pages.Enrollments.DetailsModel
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<h4>Enrollment</h4>
<hr />
<dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Item.EnrollmentID</dd>
        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.Item.Course?.Title</dd>
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model.Item.Student?.FullName</dd>
        <dt class="col-sm-3">Grade</dt>
        <dd class="col-sm-9">@Model.Item.Grade</dd>
</dl>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Item.EnrollmentID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
