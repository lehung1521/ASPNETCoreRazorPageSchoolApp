@page "{id:int?}"
@model SchoolAppCoreRazor.Pages.Enrollments.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
<div>
    <h4>Enrollment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Item.EnrollmentID</dd>
        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.Item.Course?.Title</dd>
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model.Item.Student?.FullName</dd>
        <dt class="col-sm-3">Grade</dt>
        <dd class="col-sm-9">@Model.Item.Grade</dd>
    </dl>

    <form method="post">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
